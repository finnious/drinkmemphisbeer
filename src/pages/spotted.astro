---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../lib/data';
const subject = encodeURIComponent('Spotted: Memphis beer in the wild');
const body = encodeURIComponent('Beer:\nWhere (store or bar):\nCity, state:\nDate:\nPhoto attached? (yes/no)\nOK to credit you by name? (yes/no)\n');
---
<Base title="Spotted: Memphis Beer in the Wild" description="Found a Memphis-brewed beer in another city or state? Send us a photo and we'll add it to the map.">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-7xl">Spotted</h1>
    <p class="text-xl mt-3">Memphis beer travels. Wiseacre alone has shipped as far as San Diego. When you find a Memphis-brewed beer in another city, we want to see it.</p>
    <div class="card mt-8">
      <h2 class="text-3xl">Send a sighting</h2>
      <ol class="mt-3 list-decimal pl-5 space-y-1">
        <li>Take a photo of the can, bottle or tap handle where you found it.</li>
        <li>Note the store or bar, city and state.</li>
        <li>Email it to us. We'll add it to the map and credit you if you'd like.</li>
      </ol>
      <a class="inline-block mt-4 bg-gold text-mud font-mono uppercase tracking-wider text-sm px-5 py-3 rounded no-underline" href={`mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`}>Email a sighting</a>
    </div>
    <h2 class="text-4xl mt-10">The map</h2>
    <p class="mt-2">The first sightings go up as they come in.</p>
  </div>
</Base>
