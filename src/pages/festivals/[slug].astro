---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const fests = await getCollection('festivals');
  return fests.map((f) => ({ params: { slug: f.id }, props: { fest: f } }));
}
const { fest } = Astro.props;
const { Content } = await render(fest);
const d = fest.data;
const festUrl = new URL(`/festivals/${fest.id}/`, Astro.site).href;
// Event rich results require a startDate. Until a festival has a confirmed date,
// describe it as a recurring festival without one (no Event markup).
const jsonLd = d.startDate
  ? {
      '@type': 'Festival',
      '@id': `${festUrl}#event`,
      name: d.name,
      description: d.summary,
      startDate: d.startDate,
      ...(d.endDate ? { endDate: d.endDate } : {}),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: d.where, address: { '@type': 'PostalAddress', addressLocality: 'Memphis', addressRegion: 'TN', addressCountry: 'US' } },
      ...(d.website ? { url: d.website } : {}),
      organizer: d.organizer ? { '@type': 'Organization', name: d.organizer } : undefined,
    }
  : { '@type': 'Thing', '@id': `${festUrl}#festival`, name: d.name, description: d.summary, additionalType: 'https://schema.org/Festival' };
---
<Base title={`${d.name}, Memphis`} description={(() => { let m = `${d.name}: ${d.when.toLowerCase()} at ${d.where}. ${d.summary}`; if (m.length < 120) m += ' Which Memphis breweries pour, tickets and tips.'; return m.length > 158 ? m.slice(0, 155).replace(/\s+\S*$/, '') + '…' : m; })()} jsonLd={jsonLd} crumbs={[{ name: 'Festivals', url: '/festivals/' }, { name: d.name, url: `/festivals/${fest.id}/` }]}>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav class="label"><a href="/festivals/">Festivals</a> / {d.name}</nav>
    <h1 class="text-7xl mt-2">{d.name}</h1>
    <div class="label mt-2">{d.when} · {d.where}</div>
    <div class="prose-dmb mt-6"><Content /></div>
    {d.website && <p><a href={d.website} rel="noopener" target="_blank">Official site</a></p>}
    <Sources sources={d.sources} />
  </article>
</Base>
