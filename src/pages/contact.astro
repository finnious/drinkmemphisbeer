---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../lib/data';
---
<Base pageType="ContactPage" title="Contact" description="Contact Drink Memphis Beer with a news tip, a correction, a brewery update, a Memphis beer sighting or a sponsorship question. Email or X, we read it all.">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-7xl">Contact</h1>
    <p class="mt-3">Tips, corrections, new openings, closings, Memphis beer spotted out of town: send them all.</p>
    <p class="mt-4 text-2xl"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p class="mt-4">On X: <a href="https://x.com/drinkmemphis">@drinkmemphis</a> for the site, <a href="https://x.com/willfinneymem">@willfinneymem</a> for Will.</p>
    <p class="mt-4">Want to write for the site? See <a href="/write-for-us/">write for us</a> for what we're looking for and a pitch template.</p>
  </div>
</Base>
