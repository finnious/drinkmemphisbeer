---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import { getCollection, render } from 'astro:content';
import Byline from '../../components/Byline.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getEntry } from 'astro:content';
import { authorId, personNode, FOUNDER } from '../../lib/authors';
import { IDS } from '../../lib/schema';
import pageDates from '../../data/page-dates.json';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const author = (await getEntry('authors', d.author?.id ?? FOUNDER))!;
const postUrl = new URL(`/news/${post.id}/`, Astro.site).href;
const article = {
  '@type': 'NewsArticle',
  '@id': `${postUrl}#article`,
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (pageDates as Record<string, { modified: string }>)[`/news/${post.id}/`]?.modified ?? d.date.toISOString(),
  author: { '@id': authorId(author.id) },
  publisher: { '@id': IDS.org },
  image: new URL('/images/will/news-header-1200.jpg', Astro.site).href,
  mainEntityOfPage: { '@id': `${postUrl}#webpage` },
  isPartOf: { '@id': IDS.website },
};
const jsonLd = author.id === 'will-finney' ? article : [article, personNode(author)];
---
<Base title={d.title} description={d.description} jsonLd={jsonLd} authorId={authorId(author.id)} published={d.date} crumbs={[{ name: 'News', url: '/news/' }, { name: d.title, url: `/news/${post.id}/` }]}>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav class="label"><a href="/news/">News</a></nav>
    <h1 class="text-6xl mt-2">{d.title}</h1>
    <Byline author={{ id: author.id }} date={d.date} />
    <div class="prose-dmb mt-6"><Content /></div>
    <Sources sources={d.sources} />
    <AuthorCard author={author} />
  </article>
</Base>
