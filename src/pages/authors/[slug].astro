---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { getAuthors, getStories, authorId, personNode, FOUNDER } from '../../lib/authors';
import { formatDate, beerUrl } from '../../lib/data';

export async function getStaticPaths() {
  // Will's profile is /about/.
  return (await getAuthors()).filter((a) => a.id !== FOUNDER).map((a) => ({ params: { slug: a.id }, props: { author: a } }));
}
const { author } = Astro.props;
const d = author.data;
const { Content } = await render(author);
const mine = (r: { id: string } | undefined) => r?.id === author.id;
const stories = (await getStories()).filter((s) => mine(s.data.author) || s.data.coAuthors.some(mine));
const news = (await getCollection('news')).filter((n) => mine(n.data.author)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const breweries = (await getCollection('breweries')).filter((b) => b.data.contributors.some(mine));
const beers = (await getCollection('beers')).filter((b) => b.data.contributors.some(mine));
const total = stories.length + news.length + breweries.length + beers.length;
const links = [
  d.links.x && ['X', `https://x.com/${d.links.x.replace(/^@/, '')}`],
  d.links.instagram && ['Instagram', `https://www.instagram.com/${d.links.instagram.replace(/^@/, '')}/`],
  d.links.linkedin && ['LinkedIn', d.links.linkedin],
  d.links.website && ['Website', d.links.website],
].filter(Boolean) as [string, string][];
---
<Base title={`${d.name}, ${d.role}`} description={`${d.bio} Everything ${d.name} has written for Drink Memphis Beer.`.slice(0, 158)}
  pageType="ProfilePage" jsonLd={personNode(author)} authorId={authorId(author.id)} noindex={total === 0}
  crumbs={[{ name: 'Contributors', url: '/authors/' }, { name: d.name, url: `/authors/${author.id}/` }]}>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav class="label"><a href="/authors/">Contributors</a></nav>
    <div class="mt-4 flex gap-6 items-center">
      {d.avatar && <img src={d.avatar} alt={d.name} width="140" height="140" class="rounded-full border-4 border-mud object-cover w-36 h-36" />}
      <div>
        <h1 class="text-6xl">{d.name}</h1>
        <div class="label mt-1">{d.role}{d.location && <> · {d.location}</>} · Since {formatDate(d.joined)}</div>
        {links.length > 0 && <div class="mt-2 text-sm">{links.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href} rel="me noopener">{label}</a></>)}</div>}
      </div>
    </div>
    <div class="prose-dmb mt-6"><Content /></div>

    {stories.length > 0 && (<section class="mt-10"><h2 class="text-4xl">Stories</h2><ul class="mt-3 space-y-2">{stories.map((s) => <li><a href={`/stories/${s.id}/`}>{s.data.title}</a> <span class="text-sm text-barrel">· {formatDate(s.data.date)}</span></li>)}</ul></section>)}
    {news.length > 0 && (<section class="mt-10"><h2 class="text-4xl">News</h2><ul class="mt-3 space-y-2">{news.map((n) => <li><a href={`/news/${n.id}/`}>{n.data.title}</a> <span class="text-sm text-barrel">· {formatDate(n.data.date)}</span></li>)}</ul></section>)}
    {(breweries.length > 0 || beers.length > 0) && (
      <section class="mt-10"><h2 class="text-4xl">Reporting on</h2>
        <ul class="mt-3 space-y-2">
          {breweries.map((b) => <li><a href={`/breweries/${b.id}/`}>{b.data.name}</a></li>)}
          {beers.map((b) => <li><a href={beerUrl(b)}>{b.data.name}</a></li>)}
        </ul>
      </section>
    )}
    {total === 0 && <p class="mt-10 card">{d.name}'s first piece is on the way.</p>}
  </article>
</Base>
