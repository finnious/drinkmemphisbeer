---
import Base from '../../layouts/Base.astro';
import { getBeers, getBreweries, beerUrl } from '../../lib/data';
import { FAMILIES, familyOf } from '../../lib/styles';

const beers = await getBeers();
const breweries = await getBreweries();
const breweryName = Object.fromEntries(breweries.map((b) => [b.id, b.data.name]));


const groups = new Map<string, typeof beers>();
for (const b of beers) {
  const k = familyOf(b.data.style);
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(b);
}
for (const list of groups.values()) list.sort((a, b) => a.data.name.localeCompare(b.data.name));
const families = FAMILIES.filter((f) => groups.has(f.key));
const other = groups.get('other') ?? [];
---
<Base pageType="Article" title="Beer Styles Explained, With Memphis Beers for Each" description={`A plain-English guide to beer styles, from pilsners to stouts, with ${beers.length} Memphis-area beers sorted by style.`}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <nav class="label"><a href="/guides/">Guides</a> / Beer styles</nav>
    <h1 class="text-6xl mt-2">Beer styles, explained with Memphis beers</h1>
    <div class="prose-dmb mt-4">
      <p>You don't need to know a single style name to enjoy a Memphis beer. But knowing roughly what a schwarzbier or a hazy IPA is makes a tap list a lot less intimidating. Here's every style on this site in plain English, with the Memphis beers that fit each one.</p>
      <p>We've also added a guess at how each style does on the Tap Water Test. That's the question every review here comes down to: is this better than a glass of Memphis tap water?</p>
    </div>

    <nav class="mt-6 flex flex-wrap gap-2">
      {families.map((f) => <a href={`#${f.key}`} class="label border border-mud rounded px-2 py-1 no-underline">{f.name}</a>)}
    </nav>

    {families.map((f) => (
      <section id={f.key} class="mt-12 scroll-mt-24">
        <h2 class="text-4xl">{f.name}</h2>
        <p class="mt-2">{f.blurb}</p>
        <p class="mt-2 text-sm"><strong>Tap Water Test outlook:</strong> {f.tapWater}</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {groups.get(f.key)!.map((b) => (
            <li class="card py-2">
              <a href={beerUrl(b)} class="font-semibold">{b.data.name}</a>
              <div class="text-sm">{breweryName[b.data.brewery.id] ?? ''} · {b.data.style}{b.data.abv != null && ` · ${b.data.abv}%`}</div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {other.length > 0 && (
      <section class="mt-12">
        <h2 class="text-4xl">Everything else</h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {other.map((b) => (
            <li class="card py-2"><a href={beerUrl(b)} class="font-semibold">{b.data.name}</a><div class="text-sm">{breweryName[b.data.brewery.id] ?? ''} · {b.data.style}</div></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
