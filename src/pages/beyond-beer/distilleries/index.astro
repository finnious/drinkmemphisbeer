---
import Base from '../../../layouts/Base.astro';
import BeyondCard from '../../../components/BeyondCard.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('beyond')).filter((i) => i.data.kind === 'distillery').sort((a, b) => (a.data.status === 'open' ? 0 : 1) - (b.data.status === 'open' ? 0 : 1) || a.data.name.localeCompare(b.data.name));
---
<Base pageType="CollectionPage" title="Memphis Distilleries" description="Memphis-area distilleries with tours and tastings: Old Dominick Distillery downtown, Blue Note Bourbon and more.">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="label"><a href="/beyond-beer/">Beyond Beer</a> / Distilleries</nav>
    <h1 class="text-7xl mt-2">Memphis distilleries</h1>
    <p class="mt-3 max-w-2xl">Memphis was a whiskey town long before it was a beer town, then Prohibition ended all that. These are the distilleries bringing it back, with tours and tastings you can book.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{items.map((i) => <BeyondCard item={i} />)}</div>
  </div>
</Base>
