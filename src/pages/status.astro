---
import Base from '../layouts/Base.astro';
import Sources from '../components/Sources.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getBreweries } from '../lib/data';
const breweries = await getBreweries();
---
<Base pageType="CollectionPage" title="Memphis Brewery Status Board" description="Which Memphis breweries are open right now, which have closed, and which changed hands, with the month each one was last checked. Updated weekly.">
  <div class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-7xl">Status Board</h1>
    <p class="mt-3 max-w-2xl">Breweries open, close and change hands. This is every Memphis-area brewery we track, with the last time we checked. Hours change often, so check the brewery's own site before you go.</p>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full card p-0 text-left text-base">
        <thead class="label">
          <tr><th class="p-3">Brewery</th><th class="p-3">Status</th><th class="p-3">Notes</th></tr>
        </thead>
        <tbody class="divide-y divide-[#efe6d6]">
          {breweries.map((b) => (
            <tr>
              <td class="p-3"><a href={`/breweries/${b.id}/`}>{b.data.name}</a></td>
              <td class="p-3"><StatusBadge status={b.data.status} verified={b.data.verified} /></td>
              <td class="p-3 text-sm">{b.data.statusNote ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-sm">Spot something wrong or a new opening? <a href="/contact/">Send a tip.</a></p>
    <Sources basedOn={breweries.map((b) => ({ title: b.data.name, url: `/breweries/${b.id}/` }))} note="Each status is checked against the brewery's own website and social accounts, local news and in-person mission reports, and dated with the month it was last confirmed." />
  </div>
</Base>
