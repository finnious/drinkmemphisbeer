---
import ContributorCredit from '../../components/ContributorCredit.astro';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Sources from '../../components/Sources.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getBreweries, getBeers, beerUrl } from '../../lib/data';
import { postalAddress } from '../../lib/schema';
import { shortBrewery, familyFor } from '../../lib/styles';
import { getPins, miles, walkMinutes } from '../../lib/geo';

export async function getStaticPaths() {
  const breweries = await getBreweries();
  return breweries.map((b) => ({ params: { slug: b.id }, props: { brewery: b } }));
}

const { brewery } = Astro.props;
const d = brewery.data;
const { Content } = await render(brewery);
const beers = (await getBeers()).filter((b) => b.data.brewery.id === brewery.id);
const hood = d.neighborhood ? await getEntry(d.neighborhood) : undefined;
const successor = d.successor ? (await getCollection('breweries')).find((b) => b.id === d.successor) : undefined;

const short = shortBrewery(d.name);
const town = d.town ?? 'Memphis';
const scored = beers.filter((b) => b.data.pourScore !== undefined);
const abvList = beers.map((b) => b.data.abv).filter((x): x is number => x !== undefined);
const families = [...new Set(beers.map((b) => familyFor(b.data.style)?.name).filter(Boolean))] as string[];
const pins = await getPins();
const mine = pins.filter((p) => p.slug === brewery.id);
const nearby = mine.length
  ? pins
      .filter((p) => p.slug !== brewery.id && p.status === 'open')
      .map((p) => ({ ...p, mi: Math.min(...mine.map((m) => miles(m, p))) }))
      .sort((a, b) => a.mi - b.mi)
      .filter((p, i, arr) => arr.findIndex((x) => x.slug === p.slug) === i)
      .slice(0, 3)
  : [];
const statusWord: Record<string, string> = { open: 'open', closed: 'closed', 'changed-hands': 'under new ownership', 'no-taproom': 'brewing without a taproom', unverified: 'unconfirmed' };
let metaDesc = `${d.name} in ${town} (${statusWord[d.status]}): ${d.summary}`;
if (metaDesc.length < 120) metaDesc += ` Address, ${beers.length || 'its'} beers, and what's worth ordering.`;
if (metaDesc.length > 158) metaDesc = metaDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…';
const breweryUrl = new URL(`/breweries/${brewery.id}/`, Astro.site).href;
const placeFor = (loc: (typeof d.locations)[number]) => ({
  address: postalAddress(loc.address),
  ...(loc.lat != null && loc.lng != null ? { geo: { '@type': 'GeoCoordinates', latitude: loc.lat, longitude: loc.lng } } : {}),
});
const jsonLd = {
  '@type': 'Brewery',
  '@id': `${breweryUrl}#brewery`,
  name: d.name,
  url: breweryUrl,
  image: new URL(`/og/breweries/${brewery.id}.jpg`, Astro.site).href,
  description: d.summary,
  ...(d.founded ? { foundingDate: String(d.founded) } : {}),
  ...(d.locations[0] ? placeFor(d.locations[0]) : {}),
  ...(d.locations.length > 1
    ? { department: d.locations.slice(1).map((l, i) => ({ '@type': 'Brewery', '@id': `${breweryUrl}#location-${i + 2}`, name: `${d.name} (${l.label})`, ...placeFor(l) })) }
    : {}),
  ...(d.website ? { sameAs: [d.website] } : {}),
};
---
<Base title={`${short}: ${town === 'Memphis' ? 'Memphis' : town.replace(/, (TN|MS)$/, '')} Brewery Guide`} description={metaDesc} jsonLd={jsonLd} crumbs={[{ name: 'Breweries', url: '/breweries/' }, { name: d.name, url: `/breweries/${brewery.id}/` }]}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <nav class="label"><a href="/breweries/">Breweries</a> / {d.name}</nav>
    <h1 class="text-7xl mt-2">{d.name}</h1>
    <div class="mt-3"><StatusBadge status={d.status} verified={d.verified} /></div>
    {d.statusNote && <p class="mt-2 text-barrel">{d.statusNote}</p>}
    {successor && <p class="mt-2">Now: <a href={`/breweries/${successor.id}/`}>{successor.data.name}</a></p>}

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {d.locations.map((l) => (
        <div class="card">
          <div class="label">{l.label}</div>
          <div class="mt-1">{l.address}</div>
          <a class="font-mono text-xs uppercase tracking-wider" href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(l.address)}`} rel="noopener" target="_blank">Map →</a>
        </div>
      ))}
      <div class="card">
        <div class="label">Details</div>
        <ul class="mt-1 text-base space-y-1">
          {hood && <li>Neighborhood: <a href={`/neighborhoods/${hood.id}/`}>{hood.data.name}</a></li>}
          {d.founded && <li>Founded: {d.founded}</li>}
          {d.website && <li><a href={d.website} rel="noopener" target="_blank">Brewery website</a> (check hours there)</li>}
        </ul>
      </div>
    </div>

    <div class="prose-dmb mt-8"><Content /></div>

    {beers.length > 0 && (
      <section class="mt-10 card">
        <h2 class="text-3xl">{short} at a glance</h2>
        <ul class="mt-2 space-y-1">
          <li><strong>{beers.length}</strong> {beers.length === 1 ? 'beer' : 'beers'} on this site{families.length > 0 && <>, across {families.length} style {families.length === 1 ? 'family' : 'families'}: {families.map((f) => f.toLowerCase()).join('; ')}</>}.</li>
          {abvList.length > 1 && <li>ABV runs from <strong>{Math.min(...abvList)}%</strong> to <strong>{Math.max(...abvList)}%</strong>.</li>}
          <li>{scored.length > 0
            ? <>Will has scored <strong>{scored.length}</strong> of them; <strong>{scored.filter((b) => b.data.tapWaterTest === 'passes').length}</strong> pass the <a href="/water/">Tap Water Test</a>.</>
            : <>Will hasn't scored any {short} beers yet. They're on the list.</>}</li>
          <li>Status: {statusWord[d.status]}{d.verified && <>, last checked {d.verified}</>}. See the <a href="/status/">Status Board</a> for every brewery.</li>
        </ul>
      </section>
    )}

    {beers.length > 0 && (
      <section class="mt-10">
        <h2 class="text-4xl">Beers</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {beers.map((b) => (
            <li class="card">
              <a href={beerUrl(b)} class="font-display text-2xl no-underline text-mud hover:text-brick">{b.data.name}</a>
              <div class="label">{b.data.style}{b.data.abv !== undefined && ` · ${b.data.abv}% ABV`}</div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {nearby.length > 0 && (
      <section class="mt-10">
        <h2 class="text-3xl">Nearby breweries</h2>
        <p class="mt-1 text-sm text-barrel">Straight-line distance from {short}{mine.length > 1 ? "'s closest location" : ''}.</p>
        <ul class="mt-3 grid gap-3 sm:grid-cols-3">
          {nearby.map((p) => (
            <li class="card py-2">
              <a href={p.url} class="font-semibold">{p.name}</a>
              <div class="text-sm">{p.mi.toFixed(1)} mi{p.mi < 1.5 ? ` · about ${walkMinutes(p.mi)} min walk` : ''}</div>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm">See them all on the <a href="/map/">brewery map</a>.</p>
      </section>
    )}

    <ContributorCredit contributors={d.contributors} />
    <Sources sources={d.sources} />
    <p class="mt-6 text-sm text-barrel">Something out of date? <a href="/contact/">Tell us</a> and we'll fix it.</p>
  </article>
</Base>
