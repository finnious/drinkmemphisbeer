---
import Base from '../../layouts/Base.astro';
import BreweryCard from '../../components/BreweryCard.astro';
import { getCollection, render } from 'astro:content';
import { getBreweries, getBeers, beerUrl } from '../../lib/data';
import { shortBrewery } from '../../lib/styles';
import { getPins, miles } from '../../lib/geo';

export async function getStaticPaths() {
  const hoods = await getCollection('neighborhoods');
  return hoods.map((h) => ({ params: { slug: h.id }, props: { hood: h } }));
}
const { hood } = Astro.props;
const { Content } = await render(hood);
const breweries = (await getBreweries()).filter(
  (b) => b.data.neighborhood?.id === hood.id || b.data.alsoIn.some((n) => n.id === hood.id),
);
const ids = new Set(breweries.map((b) => b.id));
const open = breweries.filter((b) => b.data.status === 'open');
const hoodBeers = (await getBeers())
  .filter((b) => ids.has(b.data.brewery.id))
  .sort((a, b) => (b.data.pourScore ?? -1) - (a.data.pourScore ?? -1) || a.data.name.localeCompare(b.data.name));
const nameOf = Object.fromEntries(breweries.map((b) => [b.id, shortBrewery(b.data.name)]));
// Other neighborhoods with open breweries close by: nearest open taproom outside this one.
const pins = (await getPins()).filter((p) => p.status === 'open');
const here = pins.filter((p) => ids.has(p.slug));
const allHoods = await getCollection('neighborhoods');
const allBreweries = await getBreweries();
const hoodOfBrewery = Object.fromEntries(allBreweries.map((b) => [b.id, b.data.neighborhood?.id]));
const nearHoods = here.length
  ? [...new Map(
      pins
        .filter((p) => !ids.has(p.slug) && hoodOfBrewery[p.slug] && hoodOfBrewery[p.slug] !== hood.id)
        .map((p) => ({ hood: hoodOfBrewery[p.slug]!, mi: Math.min(...here.map((h) => miles(h, p))) }))
        .sort((a, b) => a.mi - b.mi)
        .map((x) => [x.hood, x] as const),
    ).values()].slice(0, 3)
  : [];
const hoodName = Object.fromEntries(allHoods.map((h) => [h.id, h.data.name]));
const where = /olive branch|southaven|germantown|collierville|cordova/i.test(hood.data.name) ? hood.data.name : `${hood.data.name}, Memphis`;
let metaDesc = `${open.length || 'No'} open ${open.length === 1 ? 'brewery' : 'breweries'} in ${where}${open.length ? `: ${open.map((b) => shortBrewery(b.data.name)).join(', ')}` : ''}. ${hood.data.summary}`;
if (metaDesc.length > 158) metaDesc = metaDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…';
const hoodUrl = new URL(`/neighborhoods/${hood.id}/`, Astro.site).href;
const jsonLd = [
  { '@type': 'Place', '@id': `${hoodUrl}#place`, name: hood.data.name, description: hood.data.summary },
  { '@type': 'ItemList', name: `Breweries in ${hood.data.name}`, itemListElement: breweries.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/breweries/${b.id}/`, Astro.site).href, name: b.data.name })) },
];
---
<Base title={`Breweries in ${where}`} description={metaDesc} pageType="CollectionPage" jsonLd={jsonLd} crumbs={[{ name: 'Neighborhoods', url: '/neighborhoods/' }, { name: hood.data.name, url: `/neighborhoods/${hood.id}/` }]}>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="label"><a href="/neighborhoods/">Neighborhoods</a> / {hood.data.name}</nav>
    <h1 class="text-7xl mt-2">{hood.data.name}</h1>
    <div class="prose-dmb mt-4 max-w-2xl"><Content /></div>
    <h2 class="text-4xl mt-8">Breweries here</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {breweries.map((b) => <BreweryCard brewery={b} />)}
    </div>
    {hoodBeers.length > 0 && (
      <section class="mt-12">
        <h2 class="text-4xl">Beers brewed in {hood.data.name}</h2>
        <p class="mt-1">{hoodBeers.length} beers from {hood.data.name} breweries on this site{hoodBeers.some((b) => b.data.pourScore !== undefined) ? ", Will's top-scored first" : ''}.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {hoodBeers.map((b) => (
            <li class="card py-2">
              <a href={beerUrl(b)} class="font-semibold">{b.data.name}</a>
              <div class="text-sm">{nameOf[b.data.brewery.id]} · {b.data.style}{b.data.abv !== undefined && ` · ${b.data.abv}%`}{b.data.pourScore !== undefined && ` · Pour Score ${b.data.pourScore === 0 ? 'Tap Water' : b.data.pourScore}`}</div>
            </li>
          ))}
        </ul>
      </section>
    )}
    {nearHoods.length > 0 && (
      <section class="mt-12">
        <h2 class="text-3xl">Nearby neighborhoods</h2>
        <ul class="mt-3 flex flex-wrap gap-3">
          {nearHoods.map((n) => <li><a class="card inline-block py-2 no-underline" href={`/neighborhoods/${n.hood}/`}>{hoodName[n.hood]} <span class="text-sm text-barrel">· {n.mi.toFixed(1)} mi</span></a></li>)}
        </ul>
      </section>
    )}
    <p class="mt-8 text-sm">Planning a route? See the <a href="/map/">brewery map</a>, the <a href="/guides/">guides</a>, and <a href="/guides/where-to-buy-memphis-beer/">where to buy Memphis beer</a>.</p>
  </div>
</Base>
