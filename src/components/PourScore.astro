---
// Will's rating: 1-5 pint glasses. 0 = "Tap Water" (he'd rather have Memphis tap water).
// Only Will sets this. Leave it empty until he gives a score.
import PintIcon from './PintIcon.astro';
interface Props { score?: number; tapWaterTest?: 'passes' | 'fails' }
const { score, tapWaterTest } = Astro.props;
const full = score ? Math.floor(score) : 0;
const half = score ? score - full >= 0.5 : false;
---
<div class="card flex flex-wrap items-center gap-4">
  <div>
    <div class="label">Will's Pour Score</div>
    {score === undefined ? (
      <div class="font-display text-2xl text-barrel">Not yet rated</div>
    ) : score === 0 ? (
      <div class="font-display text-2xl text-aquifer">Tap Water <span class="font-serif text-base text-stout">(he'd rather have a glass of Memphis water)</span></div>
    ) : (
      <div class="flex items-center gap-1" aria-label={`${score} out of 5 pints`}>
        {Array.from({ length: 5 }, (_, i) => (
          <PintIcon size={28} class={i < full ? '' : i === full && half ? 'opacity-60' : 'opacity-20'} />
        ))}
        <span class="font-display text-3xl text-mud ml-2">{score}/5</span>
      </div>
    )}
  </div>
  {tapWaterTest && (
    <picture class="ml-auto">
      <source srcset={`/images/will/verdict-${tapWaterTest === 'passes' ? 'pass' : 'fail'}-300.webp`} type="image/webp" />
      <img
        src={`/images/will/verdict-${tapWaterTest === 'passes' ? 'pass' : 'fail'}-300.png`}
        alt={tapWaterTest === 'passes' ? 'Will Finney, arms crossed and smiling: Passes the Tap Water Test' : "Will Finney, arms crossed and unimpressed: I'll have the tap water"}
        width="150" height="150" class="w-[150px] h-[150px]"
      />
    </picture>
  )}
</div>
