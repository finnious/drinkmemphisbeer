---
import PintIcon from './PintIcon.astro';
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
const big = size === 'lg';
---
<span class="inline-flex items-center gap-3 no-underline">
  <PintIcon size={big ? 88 : 40} />
  <span class="font-display leading-[0.85] text-mud">
    <span class={`block tracking-[0.3em] ${big ? 'text-3xl' : 'text-sm'}`}>DRINK</span>
    <span class={`block ${big ? 'text-7xl sm:text-8xl' : 'text-3xl'}`}>MEMPHIS BEER</span>
  </span>
</span>
