---
import { getEntry } from 'astro:content';
import { authorUrl } from '../lib/authors';
import { formatDate } from '../lib/data';
interface Props { author: { id: string }; coAuthors?: { id: string }[]; date: Date; updated?: Date }
const { author, coAuthors = [], date, updated } = Astro.props;
const people = (await Promise.all([author, ...coAuthors].map((a) => getEntry('authors', a.id)))).filter(Boolean);
const lead = people[0]!;
---
<div class="mt-3 flex items-center gap-3">
  {lead.data.avatar && <img src={lead.data.avatar} alt={lead.data.name} width="48" height="48" class="rounded-full border-2 border-mud object-cover w-12 h-12" />}
  <div class="label">
    {formatDate(date)}{updated && <> · Updated {formatDate(updated)}</>} · By {people.map((p, i) => (
      <>{i > 0 && (i === people.length - 1 ? ' and ' : ', ')}<a href={authorUrl(p!.id)} rel="author">{p!.data.name}</a></>
    ))}
  </div>
</div>
